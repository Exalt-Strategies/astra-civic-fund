STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MONTHLY_PRODUCT_ID=prod_xxx
RESEND_API_KEY=re_xxx
RECEIPT_FROM=Astra Civic Fund <giving@astracivic.org>
RECEIPT_REPLY_TO=info@astracivic.org
MANAGE_SECRET=replace-with-64-random-hex-chars
SITE_URL=http://localhost:4358
# Required on Vercel: stops the platform pre-reading the request body, which the Stripe webhook needs raw for signature checks.
NODEJS_HELPERS=0

# Base URL for images in emails (receipt logo). Optional; defaults to SITE_URL.
# Local addresses are never used in emails: localhost falls back to production.
EMAIL_ASSET_URL=
